# Production environment variables. Copy to .env on the server, then edit.
# Generated by deploy.sh if missing.

# 48+ random chars. Used to sign session cookies. KEEP SECRET.
AUTH_SECRET=change-me-to-a-random-48-char-string

# Optional: GitHub OAuth for one-click sign-in.
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: https://YOUR_DOMAIN/api/auth/github?action=callback
GITHUB_ID=
GITHUB_SECRET=
